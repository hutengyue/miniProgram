/* ============ Page ============ */
.contact-page {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.contact-scroll {
  height: 100vh;
}

/* ============ Sec Header ============ */
.sec-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.sec-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 8rpx;
  padding-left: 8rpx;
}

.sec-subtitle {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 6rpx;
  margin-top: 12rpx;
}

.sec-line {
  width: 48rpx;
  height: 1rpx;
  background: #C9A962;
  margin-top: 20rpx;
}

/* ============ Contact ============ */
.sec-contact {
  padding: 120rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-qr-wrap {
  width: 520rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #EEEEEE;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 72rpx;
  box-sizing: border-box;
}

.contact-qr {
  width: 100%;
  display: block;
  border-radius: 8rpx;
  opacity: 0;
  transition: opacity 0.5s ease-out;
}

.contact-qr.img-loaded {
  opacity: 1;
}

.contact-phone {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.contact-phone-num {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.contact-call-icon {
  font-size: 40rpx;
  color: #1A1A1A;
}

.contact-phone-label {
  font-size: 22rpx;
  color: #BBBBBB;
  letter-spacing: 4rpx;
  margin-top: 16rpx;
}

/* ============ Social 社媒二维码 ============ */
.sec-social {
  padding: 80rpx 48rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-list {
  display: flex;
  gap: 48rpx;
  margin-top: 32rpx;
}

.social-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-qr-wrap {
  width: 280rpx;
  height: 280rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #EEEEEE;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.social-qr {
  width: 100%;
  height: 100%;
  background: #F5F5F5;
  border-radius: 8rpx;
  opacity: 0;
  transition: opacity 0.5s ease-out;
}

.social-qr.img-loaded {
  opacity: 1;
}

.social-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  margin-top: 28rpx;
}

.social-handle {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

.social-long-press {
  font-size: 18rpx;
  color: #CCCCCC;
  letter-spacing: 1rpx;
  margin-top: 20rpx;
}

.contact-bottom-space {
  height: 180rpx;
}
