.home-page {
  position: relative;
  width: 100%;
  height: 100vh;
  background-color: #0A0A0A;
}

.top-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  min-height: 88rpx;
  z-index: 100;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding-left: 24rpx;
  padding-right: 24rpx;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 0%,
    rgba(0, 0, 0, 0) 100%
  );
}

.top-bar-left {
  width: 80rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar-icon {
  font-size: 36rpx;
  color: #FFFFFF;
}

.top-bar-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar-logo-img {
  height: 108rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.5s ease-out;
}

.top-bar-logo-img.img-loaded {
  opacity: 1;
}

.top-bar-right {
  width: 80rpx;
}

.home-swiper {
  width: 100%;
  height: 100%;
}

.swiper-item {
  width: 100%;
  height: 100vh;
}

.slide {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

.slide-video-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.slide-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0;
  transition: opacity 0.5s ease-out;
}

.slide-bg.img-loaded {
  opacity: 1;
}

.slide-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(
    180deg,
    rgba(10, 10, 10, 0.4) 0%,
    rgba(10, 10, 10, 0.2) 40%,
    rgba(10, 10, 10, 0.5) 70%,
    rgba(10, 10, 10, 0.9) 100%
  );
}

.slide-content {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 0 48rpx;
}

.hero-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 50vh;
}

.hero-title {
  font-size: 52rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 6rpx;
  text-align: center;
}

.hero-subtitle {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 3rpx;
  text-align: center;
  margin-top: 24rpx;
  font-weight: 300;
}

.hero-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 28rpx;
}

.hero-desc-line {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 2;
  text-align: center;
  letter-spacing: 2rpx;
}

.cta-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 120rpx;
}

.cta-btn {
  width: 320rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.05);
}

.cta-hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: rgba(255, 255, 255, 0.6);
}

.cta-text {
  font-size: 30rpx;
  color: #FFFFFF;
  letter-spacing: 6rpx;
  font-weight: 300;
}

.scroll-hint {
  margin-top: auto;
  display: flex;
  justify-content: center;
  align-items: center;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.scroll-arrow {
  width: 20rpx;
  height: 20rpx;
  border-right: 2rpx solid rgba(255, 255, 255, 0.5);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.5);
  transform: rotate(45deg);
}
