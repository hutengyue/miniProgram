<view class="home-page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar-center">
      <image class="top-bar-logo-img {{loadedImages[brand.logo] ? 'img-loaded' : ''}}" src="{{brand.logo}}" mode="heightFix" bindload="onImgLoad" binderror="onImgError" data-src="{{brand.logo}}"></image>
    </view>
  </view>

  <swiper class="home-swiper" vertical="{{true}}" autoplay="{{false}}" circular="{{false}}" indicator-dots="{{false}}" duration="{{400}}" bindchange="onSwiperChange">
    <swiper-item class="swiper-item" wx:for="{{slides}}" wx:key="id">
      <view class="slide">
        <video
          wx:if="{{item.video}}"
          class="slide-video-bg"
          src="{{item.video}}"
          autoplay="{{true}}"
          muted="{{true}}"
          loop="{{true}}"
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          show-fullscreen-btn="{{false}}"
          show-progress="{{false}}"
          enable-progress-gesture="{{false}}"
          object-fit="cover"></video>
        <image wx:else class="slide-bg {{loadedImages[item.image] ? 'img-loaded' : ''}}" src="{{item.image}}" mode="aspectFill" bindload="onImgLoad" binderror="onImgError" data-src="{{item.image}}"></image>
        <view class="slide-overlay"></view>
        <view class="slide-content">
          <view class="hero-text">
            <view class="hero-title">{{item.title}}</view>
            <view class="hero-subtitle">{{item.subtitle}}</view>
            <view class="hero-desc" wx:if="{{item.desc && item.desc.length}}">
              <view class="hero-desc-line" wx:for="{{item.desc}}" wx:for-item="line" wx:key="*this">{{line}}</view>
            </view>
          </view>
          <view class="cta-wrapper">
            <view class="cta-btn" data-tab="{{item.tabPath}}" bindtap="onExplore" hover-class="cta-hover">
              <text class="cta-text">{{item.buttonText}}</text>
            </view>
          </view>
          <view class="scroll-hint">
            <view class="scroll-arrow"></view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>
