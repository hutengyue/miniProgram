page {
  height: 100%;
}

.products-page {
  width: 100%;
  height: 100vh;
  background-color: #F4F4F4;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.search-section {
  padding: 20rpx 32rpx 12rpx;
  background: #F4F4F4;
}

.search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 0 0 0 24rpx;
  border: 1rpx solid #EAEAEA;
  overflow: hidden;
}

.search-icon-btn {
  width: 80rpx;
  height: 80rpx;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.search-icon-img {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
  letter-spacing: 1rpx;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.clear-line {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  background: #CCCCCC;
  border-radius: 1rpx;
  top: 19rpx;
  left: 9rpx;
}

.clear-line-left { transform: rotate(45deg); }
.clear-line-right { transform: rotate(-45deg); }

.products-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
}

.category-nav {
  width: 200rpx;
  height: 100%;
  background: #FAFAFA;
}

.category-major {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  background: #FAFAFA;
  border-bottom: 1rpx solid #F0F0F0;
}

.cat-name {
  letter-spacing: 2rpx;
}

.cat-arrow {
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
}

.sub-list {
  background: #F2F2F2;
}

.category-sub {
  padding: 26rpx 24rpx 26rpx 44rpx;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #EAEAEA;
  letter-spacing: 1rpx;
}

.cat-active {
  background: #FFFFFF;
  color: #1A1A1A;
  font-weight: 600;
  position: relative;
}

.category-major.cat-active {
  background: #FFFFFF;
}

.category-sub.cat-active {
  background: #FFFFFF;
  color: #1A1A1A;
  font-weight: 600;
}

.cat-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 4rpx;
  background: #1A1A1A;
}

.content-area {
  flex: 1;
  height: 100%;
  background: #F4F4F4;
}

.section {
  padding: 0 20rpx;
}

.banner-wrap {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 3rpx;
  padding: 24rpx 8rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-card {
  width: calc((100% - 16rpx) / 2);
  border-radius: 8rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  margin-bottom: 16rpx;
}

.product-img {
  width: 100%;
  height: 240rpx;
  background: #F7F7F7;
}

.product-name {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  letter-spacing: 1rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #BBBBBB;
  letter-spacing: 4rpx;
}

.nav-bottom-space {
  height: 160rpx;
}

.bottom-space {
  height: 160rpx;
}
