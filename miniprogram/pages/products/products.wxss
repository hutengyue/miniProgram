page {
  height: 100%;
}

.products-page {
  width: 100%;
  height: 100vh;
  background-color: #FFFFFF;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(130rpx + env(safe-area-inset-bottom));
}

.search-bar {
  display: flex;
  align-items: stretch;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #F0F0F0;
}

.search-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  height: 72rpx;
  border: 1rpx solid #CCCCCC;
  border-right: none;
  padding: 0 20rpx;
  background: #FFFFFF;
}

.search-icon {
  font-size: 32rpx;
  color: #999999;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
  height: 100%;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
}

.search-btn {
  width: 140rpx;
  height: 72rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 6rpx;
}

.products-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
}

.category-nav {
  width: 200rpx;
  height: 100%;
  background: #FAFAFA;
}

.category-major {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  font-size: 28rpx;
  color: #333333;
  background: #FAFAFA;
  border-bottom: 1rpx solid #F0F0F0;
}

.cat-name {
  letter-spacing: 2rpx;
}

.cat-arrow {
  font-size: 32rpx;
  color: #999999;
  line-height: 1;
}

.sub-list {
  background: #F2F2F2;
}

.category-sub {
  padding: 26rpx 24rpx 26rpx 44rpx;
  font-size: 26rpx;
  color: #666666;
  border-bottom: 1rpx solid #EAEAEA;
  letter-spacing: 1rpx;
}

.cat-active {
  background: #FFFFFF;
  color: #1A1A1A;
  font-weight: 600;
  position: relative;
}

.category-major.cat-active {
  background: #FFFFFF;
}

.category-sub.cat-active {
  background: #FFFFFF;
  color: #1A1A1A;
  font-weight: 600;
}

.cat-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  height: 60%;
  width: 4rpx;
  background: #1A1A1A;
}

.nav-bottom-space {
  height: 120rpx;
}

.content-area {
  flex: 1;
  height: 100%;
  background: #FFFFFF;
}

.section {
  padding: 0 20rpx;
}

.banner-wrap {
  width: 100%;
  height: 320rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-top: 20rpx;
}

.banner-img {
  width: 100%;
  height: 100%;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 3rpx;
  padding: 24rpx 8rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.product-card {
  width: calc((100% - 16rpx) / 2);
  border-radius: 8rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  margin-bottom: 16rpx;
}

.product-img {
  width: 100%;
  height: 240rpx;
  background: #F7F7F7;
}

.product-name {
  padding: 16rpx 12rpx;
  font-size: 24rpx;
  color: #333333;
  text-align: center;
  letter-spacing: 1rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  font-size: 26rpx;
  color: #BBBBBB;
  letter-spacing: 4rpx;
}

.bottom-space {
  height: 160rpx;
}
