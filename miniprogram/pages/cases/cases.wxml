<view class="cases-page">
  <scroll-view class="cases-scroll" scroll-y>

    <!-- 左上角三模块切换 -->
    <view class="module-tabs">
      <view class="module-tab {{activeModule === item.id ? 'active' : ''}}"
        wx:for="{{modules}}" wx:key="id"
        data-id="{{item.id}}" bindtap="onModuleChange">
        <view class="module-tab-text">{{item.name}}</view>
        <view class="module-tab-line"></view>
      </view>
    </view>

    <!-- 搜索框 -->
    <view class="search-section">
      <view class="search-box">
        <input class="search-input" placeholder="{{activeModule === 'address' ? '请输入小区关键词' : activeModule === 'product' ? '请输入型号关键词' : '请输入视频关键词'}}" placeholder-class="search-placeholder" value="{{searchKeyword}}" bindinput="onSearchInput" confirm-type="search" />
        <view wx:if="{{searchKeyword}}" class="search-clear" bindtap="onClearSearch">
          <view class="clear-line clear-line-left"></view>
          <view class="clear-line clear-line-right"></view>
        </view>
        <view class="search-icon-btn">
          <image class="search-icon-img" src="/images/search.png" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- ========== 地址模块：按小区分组 ========== -->
    <view class="module-view" wx:if="{{activeModule === 'address'}}">
      <view class="address-group" wx:for="{{addressGroups}}" wx:key="id" wx:for-item="group" wx:for-index="groupIndex">
        <view class="group-header">
          <view class="group-name">{{group.community}}</view>
          <view class="group-location">{{group.location}}</view>
          <view class="group-line"></view>
        </view>
        <view class="group-grid">
          <view class="group-img-item" wx:for="{{group.images}}" wx:key="id" wx:for-item="img" wx:for-index="imgIndex"
            data-group="{{groupIndex}}" data-index="{{imgIndex}}" bindtap="onPreviewImage">
            <image class="group-img {{loadedImages[img.image] ? 'img-loaded' : ''}}" src="{{img.image}}" mode="aspectFill" lazy-load="true" bindload="onImgLoad" binderror="onImgError" data-src="{{img.image}}"></image>
          </view>
        </view>
      </view>
      <view class="cases-empty" wx:if="{{addressGroups.length === 0}}">
        <text class="empty-text">未找到相关小区</text>
      </view>
    </view>

    <!-- ========== 产品模块：平铺网格 ========== -->
    <view class="module-view" wx:elif="{{activeModule === 'product'}}">
      <view class="product-grid">
        <view class="product-item" wx:for="{{products}}" wx:key="id">
          <view class="product-img-wrap">
            <image class="product-img {{loadedImages[item.image] ? 'img-loaded' : ''}}" src="{{item.image}}" mode="aspectFill" lazy-load="true" bindload="onImgLoad" binderror="onImgError" data-src="{{item.image}}"></image>
          </view>
          <view class="product-name">{{item.name}}</view>
        </view>
      </view>
      <view class="cases-empty" wx:if="{{products.length === 0}}">
        <text class="empty-text">未找到相关产品</text>
      </view>
    </view>

    <!-- ========== 视频模块：视频卡片 ========== -->
    <view class="module-view" wx:elif="{{activeModule === 'video'}}">
      <view class="video-list">
        <view class="video-card" wx:for="{{videos}}" wx:key="id">
          <view class="video-cover-wrap">
            <video wx:if="{{playingVideoId === item.id}}" class="video-player" src="{{item.url}}" autoplay controls object-fit="cover"></video>
            <view wx:else class="video-cover" data-id="{{item.id}}" bindtap="onPlayVideo">
              <image class="video-poster {{loadedImages[item.poster] ? 'img-loaded' : ''}}" src="{{item.poster}}" mode="aspectFill" lazy-load="true" bindload="onImgLoad" binderror="onImgError" data-src="{{item.poster}}"></image>
              <view class="video-play-btn">
                <view class="play-triangle"></view>
              </view>
            </view>
          </view>
          <view class="video-title">{{item.title}}</view>
        </view>
      </view>
      <view class="cases-empty" wx:if="{{videos.length === 0}}">
        <text class="empty-text">未找到相关视频</text>
      </view>
    </view>

    <view class="cases-bottom-space"></view>
  </scroll-view>
</view>
