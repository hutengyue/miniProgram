.cases-page {
  width: 100%;
  min-height: 100vh;
  background-color: #F4F4F4;
}

.cases-scroll {
  height: 100vh;
}

/* ============ 左上角模块切换 ============ */
.module-tabs {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
}

.module-tab {
  margin-right: 56rpx;
  position: relative;
  padding-bottom: 16rpx;
}

.module-tab-text {
  font-size: 30rpx;
  color: #999999;
  letter-spacing: 4rpx;
  transition: color 0.3s ease;
}

.module-tab.active .module-tab-text {
  color: #1A1A1A;
  font-weight: 600;
}

.module-tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 0;
  height: 4rpx;
  background: #1A1A1A;
  border-radius: 2rpx;
  transform: translateX(-50%);
  transition: width 0.3s ease;
}

.module-tab.active .module-tab-line {
  width: 40rpx;
}

/* ============ 二级小区分类 tab ============ */
.community-tabs {
  white-space: nowrap;
  padding: 24rpx 32rpx 4rpx;
}

.community-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  background: #FFFFFF;
  border-radius: 8rpx;
  margin-right: 16rpx;
  letter-spacing: 2rpx;
}

.community-tab.active {
  color: #FFFFFF;
  background: #1A1A1A;
}

/* ============ 模块视图切换动画 ============ */
.module-view {
  animation: moduleFadeIn 0.4s ease-out;
}

@keyframes moduleFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============ 地址模块：当前小区图片 ============ */
.address-group {
  padding: 32rpx 32rpx 8rpx;
}

.group-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.group-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 6rpx;
  padding-left: 6rpx;
}

.group-location {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 3rpx;
  margin-top: 8rpx;
}

.group-line {
  width: 48rpx;
  height: 1rpx;
  background: #C9A962;
  margin-top: 16rpx;
}

.group-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.group-img-item {
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
}

.group-img {
  width: 100%;
  height: 340rpx;
  background: #E8E8E8;
  border-radius: 8rpx;
  display: block;
  opacity: 0;
  transition: opacity 0.45s ease-out;
}

.group-img.img-loaded {
  opacity: 1;
}

/* ============ 产品模块：平铺网格 ============ */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 32rpx 0;
  justify-content: space-between;
}

.product-item {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.product-img-wrap {
  width: 100%;
  overflow: hidden;
}

.product-img {
  width: 100%;
  height: 380rpx;
  background: #E8E8E8;
  display: block;
  opacity: 0;
  transition: opacity 0.45s ease-out;
}

.product-img.img-loaded {
  opacity: 1;
}

.product-name {
  padding: 20rpx 20rpx 24rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* ============ 视频模块：竖版 9:16 两列卡片 ============ */
.video-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx 32rpx 0;
}

.video-card {
  width: calc(50% - 12rpx);
  margin-bottom: 32rpx;
}

.video-cover {
  position: relative;
  width: 100%;
  border-radius: 12rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.video-cover-hover {
  opacity: 0.85;
}

.video-poster {
  width: 100%;
  height: 590rpx;
  background: #E8E8E8;
  display: block;
  opacity: 0;
  transition: opacity 0.45s ease-out;
}

.video-poster.img-loaded {
  opacity: 1;
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.play-triangle {
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.95);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  margin-left: 7rpx;
}

.video-title {
  padding: 20rpx 8rpx 0;
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ============ Empty ============ */
.cases-empty {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  letter-spacing: 2rpx;
}

.cases-bottom-space {
  height: 180rpx;
}
