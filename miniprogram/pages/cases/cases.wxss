.cases-page {
  width: 100%;
  min-height: 100vh;
  background-color: #F4F4F4;
}

.cases-scroll {
  height: 100vh;
}

/* Search */
.search-section {
  padding: 20rpx 32rpx 12rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 80rpx;
  background: #FFFFFF;
  border-radius: 10rpx;
  padding: 0 0 0 24rpx;
  border: 1rpx solid #EAEAEA;
  overflow: hidden;
}

.search-icon-btn {
  width: 80rpx;
  height: 80rpx;
  background: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.search-icon-img {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: #1A1A1A;
  background: transparent;
  letter-spacing: 1rpx;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.clear-line {
  position: absolute;
  width: 22rpx;
  height: 2rpx;
  background: #CCCCCC;
  border-radius: 1rpx;
  top: 19rpx;
  left: 9rpx;
}

.clear-line-left { transform: rotate(45deg); }
.clear-line-right { transform: rotate(-45deg); }

/* Filter Tabs */
.filter-tabs {
  white-space: nowrap;
  padding: 16rpx 32rpx 20rpx;
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  background: #FFFFFF;
  border-radius: 8rpx;
  margin-right: 16rpx;
  letter-spacing: 1rpx;
}

.filter-tab.active {
  color: #FFFFFF;
  background: #1A1A1A;
}

/* Cases Grid */
.cases-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 32rpx 0;
  justify-content: space-between;
}

.case-item {
  width: calc(50% - 12rpx);
  margin-bottom: 24rpx;
}

.case-card {
  background: #FFFFFF;
  border-radius: 12rpx;
  overflow: hidden;
}

.case-img-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.case-img {
  width: 100%;
  height: 380rpx;
  background: #E8E8E8;
  display: block;
}

.case-brand-tag {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 18rpx;
  color: #FFFFFF;
  letter-spacing: 1rpx;
  background: rgba(0, 0, 0, 0.35);
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
}

.case-info {
  padding: 24rpx 20rpx 28rpx;
}

.case-title {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* Empty */
.cases-empty {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
  letter-spacing: 2rpx;
}

.cases-bottom-space {
  height: 180rpx;
}
