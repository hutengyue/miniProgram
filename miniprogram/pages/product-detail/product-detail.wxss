.detail-page {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.detail-scroll {
  height: 100vh;
}

/* ============ 产品标题 ============ */
.detail-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 72rpx 48rpx 40rpx;
}

.detail-name {
  font-size: 40rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 6rpx;
  padding-left: 6rpx;
}

.detail-id {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 4rpx;
  margin-top: 12rpx;
  text-transform: uppercase;
}

.detail-line {
  width: 48rpx;
  height: 1rpx;
  background: #C9A962;
  margin-top: 24rpx;
}

/* ============ 模块切换 tab ============ */
.module-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx 24rpx;
}

.module-tab {
  margin: 0 40rpx;
  position: relative;
  padding-bottom: 14rpx;
}

.module-tab-text {
  font-size: 28rpx;
  color: #999999;
  letter-spacing: 4rpx;
  transition: color 0.25s ease;
}

.module-tab.active .module-tab-text {
  color: #1A1A1A;
  font-weight: 600;
}

.module-tab-line {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 0;
  height: 4rpx;
  background: #1A1A1A;
  border-radius: 2rpx;
  transform: translateX(-50%);
  transition: width 0.25s ease;
}

.module-tab.active .module-tab-line {
  width: 40rpx;
}

/* ============ 模块切换动画 ============ */
.module-view {
  animation: moduleFadeIn 0.4s ease-out;
}

@keyframes moduleFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ============ 图片模块：四周留边距 ============ */
.image-module {
  padding: 0 36rpx 8rpx;
}

.detail-img {
  width: 100%;
  display: block;
  margin-bottom: 24rpx;
  background: #F7F7F7;
  opacity: 0;
  transition: opacity 0.45s ease-out;
}

.detail-img.img-loaded {
  opacity: 1;
}

/* ============ 视频模块：竖版 9:16 ============ */
.video-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 8rpx 32rpx 0;
}

.video-card {
  width: calc(50% - 12rpx);
  margin-bottom: 32rpx;
}

.video-cover {
  position: relative;
  width: 100%;
  border-radius: 8rpx;
  overflow: hidden;
}

.video-cover-hover {
  opacity: 0.85;
}

.video-poster {
  width: 100%;
  height: 560rpx;
  background: #F7F7F7;
  display: block;
  opacity: 0;
  transition: opacity 0.45s ease-out;
}

.video-poster.img-loaded {
  opacity: 1;
}

.video-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 88rpx;
  height: 88rpx;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.play-triangle {
  width: 0;
  height: 0;
  border-left: 26rpx solid rgba(255, 255, 255, 0.95);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  margin-left: 7rpx;
}

.video-title {
  padding: 20rpx 8rpx 0;
  font-size: 24rpx;
  color: #1A1A1A;
  font-weight: 500;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ============ Empty ============ */
.detail-empty {
  display: flex;
  justify-content: center;
  padding: 200rpx 0;
}

.detail-empty-text {
  font-size: 26rpx;
  color: #BBBBBB;
  letter-spacing: 2rpx;
}
