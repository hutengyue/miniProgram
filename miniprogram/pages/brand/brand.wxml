<view class="panorama-page">
  <canvas type="2d" id="panoramaCanvas" class="panorama-canvas"
    bindtouchstart="onPanoramaTouchStart"
    bindtouchmove="onPanoramaTouchMove"
    bindtouchend="onPanoramaTouchEnd"></canvas>

  <view class="panorama-overlay-top">
    <view class="panorama-brand">{{brand.brandName}}</view>
    <view class="panorama-slogan">{{brand.slogan}}</view>
  </view>

  <view class="panorama-hint" wx:if="{{showHint}}">
    <text class="panorama-hint-text">拖拽旋转 · 360°全景</text>
  </view>

  <view class="panorama-switcher">
    <view class="panorama-switcher-inner">
      <view class="panorama-thumb {{currentPanoramaIndex === index ? 'panorama-thumb-active' : ''}}"
        wx:for="{{brand.panoramas}}" wx:key="id"
        data-index="{{index}}"
        bindtap="onSwitchPanorama">
        <image class="panorama-thumb-img" src="{{item.thumb}}" mode="aspectFill"></image>
        <text class="panorama-thumb-name">{{item.name}}</text>
      </view>
    </view>
  </view>
</view>
