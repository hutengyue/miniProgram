.brand-page {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.brand-scroll {
  height: 100vh;
}

.brand-hero {
  position: relative;
  width: 100%;
  height: 500rpx;
  overflow: hidden;
}

.brand-hero-img {
  width: 100%;
  height: 100%;
}

.brand-hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    180deg,
    rgba(0, 0, 0, 0.4) 50%,
    rgba(0, 0, 0, 0.75) 80%,
    rgba(0, 0, 0, 0.9) 100%
  );
}

.brand-logo {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 42rpx;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 10rpx;
  font-weight: 300;
  white-space: nowrap;
}

.brand-content {
  padding: 48rpx 48rpx 180rpx;
}

.brand-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-title {
  font-size: 48rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.brand-subtitle {
  font-size: 22rpx;
  color: #999999;
  letter-spacing: 6rpx;
  text-transform: uppercase;
}

.brand-divider-line {
  width: 60rpx;
  height: 2rpx;
  background-color: #C9A962;
  margin: 0 auto 48rpx;
}

.brand-desc {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.brand-desc-line {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.8;
  text-align: center;
  letter-spacing: 2rpx;
}

.brand-philosophy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.philosophy-item {
  font-size: 28rpx;
  color: #666666;
  letter-spacing: 4rpx;
  font-weight: 300;
  margin-bottom: 16rpx;
}

.brand-closing {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.closing-item {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
  letter-spacing: 2rpx;
  text-align: center;
  margin-bottom: 12rpx;
}

.brand-bottom-space {
  height: 160rpx;
}
