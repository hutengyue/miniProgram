.panorama-page {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: #0A0A0A;
}

.panorama-canvas {
  width: 100%;
  height: 100%;
}

.panorama-overlay-top {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding-top: calc(env(safe-area-inset-top) + 40rpx);
  padding-left: 48rpx;
  padding-right: 48rpx;
  display: flex;
  flex-direction: column;
  pointer-events: none;
}

.panorama-brand {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 8rpx;
  font-weight: 300;
  margin-bottom: 8rpx;
}

.panorama-slogan {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 4rpx;
}

.panorama-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.45);
  border-radius: 40rpx;
  padding: 20rpx 48rpx;
  pointer-events: none;
}

.panorama-hint-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  letter-spacing: 4rpx;
}

/* 底部切换栏 */
.panorama-switcher {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 130rpx);
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-top: 24rpx;
  pointer-events: none;
}

.panorama-switcher-inner {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  pointer-events: auto;
}

.panorama-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.panorama-thumb-img {
  width: 140rpx;
  height: 100rpx;
  border-radius: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  overflow: hidden;
}

.panorama-thumb-active .panorama-thumb-img {
  border-color: #FFFFFF;
}

.panorama-thumb-name {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

.panorama-thumb-active .panorama-thumb-name {
  color: #FFFFFF;
  font-weight: 500;
}
