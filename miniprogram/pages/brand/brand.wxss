.brand-page {
  width: 100%;
  min-height: 100vh;
  background-color: #FFFFFF;
}

.brand-scroll {
  height: 100vh;
}

/* ============ Hero ============ */
.sec-hero {
  position: relative;
  width: 100%;
  padding: 40rpx 32rpx;
}

.hero-bg {
  width: 100%;
  display: block;
  border-radius: 4rpx;
  filter: grayscale(100%) brightness(0.55);
}

.hero-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hero-name {
  font-size: 56rpx;
  font-weight: 100;
  letter-spacing: 28rpx;
  color: #FFFFFF;
  padding-left: 28rpx;
  margin-bottom: 36rpx;
}

.hero-mono {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-mono-line {
  width: 48rpx;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.5);
}

.hero-mono-text {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 6rpx;
}

/* ============ Quote ============ */
.sec-quote {
  padding: 140rpx 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quote-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 8rpx;
}

.quote-subtitle {
  font-size: 20rpx;
  color: #AAAAAA;
  letter-spacing: 10rpx;
  margin-top: 24rpx;
}

.quote-divider {
  width: 60rpx;
  height: 1rpx;
  background: #CCCCCC;
  margin: 64rpx 0 64rpx;
}

.quote-lines {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.quote-line {
  font-size: 26rpx;
  color: #333333;
  letter-spacing: 3rpx;
  text-align: center;
}

/* ============ Text ============ */
.sec-text {
  padding: 40rpx 64rpx 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.text-para {
  font-size: 24rpx;
  color: #777777;
  line-height: 2.2;
  letter-spacing: 1rpx;
  text-align: center;
  margin-bottom: 28rpx;
}

.text-brand-line {
  margin-top: 48rpx;
  font-size: 20rpx;
  color: #AAAAAA;
  letter-spacing: 6rpx;
}

.text-end-line {
  margin-top: 20rpx;
  font-size: 18rpx;
  color: #CCCCCC;
  letter-spacing: 8rpx;
}

/* ============ Image ============ */
.sec-image {
  width: 100%;
  padding: 40rpx 32rpx;
}

.full-img {
  width: 100%;
  display: block;
  border-radius: 4rpx;
}

/* ============ Section通用 ============ */
.sec-section {
  padding: 140rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sec-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 72rpx;
}

.sec-num {
  font-size: 20rpx;
  color: #CCCCCC;
  letter-spacing: 4rpx;
  font-weight: 300;
  margin-bottom: 16rpx;
}

.sec-title {
  font-size: 40rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 8rpx;
}

.sec-subtitle {
  font-size: 18rpx;
  color: #BBBBBB;
  letter-spacing: 10rpx;
  margin-top: 20rpx;
}

.sec-line {
  width: 60rpx;
  height: 1rpx;
  background: #D0D0D0;
  margin-top: 40rpx;
}

.sec-paragraphs {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.sec-para {
  font-size: 25rpx;
  color: #555555;
  line-height: 2;
  letter-spacing: 0.5rpx;
  text-align: justify;
  max-width: 580rpx;
}

.sec-img {
  width: 100%;
  border-radius: 4rpx;
  display: block;
  margin-top: 32rpx;
}

/* ============ Timeline ============ */
.timeline {
  width: 100%;
  max-width: 560rpx;
  position: relative;
  padding-left: 96rpx;
}

.timeline::before {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: #E5E5E5;
}

.timeline-item {
  position: relative;
  padding-bottom: 64rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.tl-dot {
  position: absolute;
  left: -78rpx;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1A1A1A;
}

.tl-year {
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}

.tl-text {
  font-size: 23rpx;
  color: #777777;
  line-height: 1.9;
  letter-spacing: 0.3rpx;
}

/* ============ Contact ============ */
.sec-contact {
  padding: 140rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-qr {
  width: 480rpx;
  display: block;
  border-radius: 8rpx;
  margin-bottom: 72rpx;
}

.contact-phone {
  width: 480rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx;
  background: #FAFAFA;
  border-radius: 12rpx;
  border: 1rpx solid #EEEEEE;
}

.contact-phone-num {
  font-size: 32rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

.contact-call-btn {
  font-size: 26rpx;
  color: #FFFFFF;
  letter-spacing: 4rpx;
  padding: 14rpx 40rpx;
  background: #1A1A1A;
  border-radius: 32rpx;
}

/* ============ Social 社媒二维码 ============ */
.sec-social {
  padding: 140rpx 48rpx 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-list {
  display: flex;
  gap: 48rpx;
  margin-top: 32rpx;
}

.social-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.social-qr-wrap {
  width: 280rpx;
  height: 280rpx;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #EEEEEE;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
}

.social-qr {
  width: 100%;
  height: 100%;
  background: #F5F5F5;
  border-radius: 8rpx;
}

.social-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1A1A1A;
  letter-spacing: 4rpx;
  margin-top: 28rpx;
}

.social-handle {
  font-size: 20rpx;
  color: #BBBBBB;
  letter-spacing: 1rpx;
  margin-top: 8rpx;
}

.social-long-press {
  font-size: 18rpx;
  color: #CCCCCC;
  letter-spacing: 1rpx;
  margin-top: 20rpx;
}

/* ============ Bottom ============ */
.brand-bottom-space {
  height: 240rpx;
}
