.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 130rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #0A0A0A;
  z-index: 999;
  transition: background-color 0.3s ease;
}

.tab-bar.tab-bar-transparent {
  background-color: transparent;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 0rpx;
  background: rgba(255, 255, 255, 0.08);
}

.tab-bar-transparent .tab-bar-border {
  background: rgba(255, 255, 255, 0.15);
}

.tab-bar-inner {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: space-around;
  padding: 0 16rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 8rpx;
}

.tab-item-hover {
  opacity: 0.7;
}

/* ============ 图标 ============ */
.tab-icon-wrap {
  line-height: 1;
}

/* ============ 文字 ============ */
.tab-text {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 2rpx;
  font-weight: 300;
  margin-top: 8rpx;
  transition: color 0.25s ease;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: 400;
}

/* ============ 下划线（绝对定位钉底，仅透明度切换） ============ */
.tab-underline {
  position: absolute;
  bottom: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 3rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.tab-item.active .tab-underline {
  opacity: 1;
}
