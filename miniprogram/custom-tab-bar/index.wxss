.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 130rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background-color: #0A0A0A;
  z-index: 999;
}

.tab-bar-border {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.08);
}

.tab-bar-inner {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: space-around;
  padding: 0 16rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 0 8rpx;
}

.tab-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 2rpx;
  font-weight: 300;
  transition: color 0.2s ease;
}

.tab-item.active .tab-text {
  color: #FFFFFF;
  font-weight: 400;
}

.tab-underline {
  margin-top: 10rpx;
  width: 32rpx;
  height: 4rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
}
