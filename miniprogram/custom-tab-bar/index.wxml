<view class="tab-bar">
  <view class="tab-bar-border"></view>
  <view class="tab-bar-inner">
    <view class="tab-item {{selected === index ? 'active' : ''}}"
          wx:for="{{list}}"
          wx:key="index"
          data-index="{{index}}"
          bindtap="switchTab">
      <text class="tab-text">{{item.text}}</text>
      <view class="tab-underline" wx:if="{{selected === index}}"></view>
    </view>
  </view>
</view>
